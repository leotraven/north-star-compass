<section id="how-it-works" class="py-8 md:py-10 px-4 sm:px-8">
  <div class="max-w-2xl mx-auto flex flex-col gap-3">
    <article class="rounded-2xl border border-base-800 bg-base-900 p-5">
      <p class="text-[11px] tracking-wide uppercase text-primary">Input 1</p>
      <h3 class="mt-2 text-base-100 font-medium">Your North Star</h3>
      <p class="mt-1 text-sm text-base-400">
        Your long-term goal, identity shift, or strategic direction.
      </p>
    </article>
    <article class="rounded-2xl border border-base-800 bg-base-900 p-5">
      <p class="text-[11px] tracking-wide uppercase text-primary">Input 2</p>
      <h3 class="mt-2 text-base-100 font-medium">Immediate Action</h3>
      <p class="mt-1 text-sm text-base-400">
        The decision in front of you right now that needs a yes or no.
      </p>
    </article>
    <article class="rounded-2xl border border-base-800 bg-base-900 p-5">
      <p class="text-[11px] tracking-wide uppercase text-primary">Output</p>
      <h3 class="mt-2 text-base-100 font-medium">Brutally Clear Signal</h3>
      <p class="mt-1 text-sm text-base-400">
        Toward, away, or neutral, with the strategic why behind it.
      </p>
    </article>
  </div>
</section>

<section id="compass-check" class="py-3 pb-16 md:pb-20 px-4 sm:px-8">
  <div class="max-w-2xl mx-auto rounded-3xl border border-base-800 bg-base-925 shadow-[0_0_0_1px_rgba(255,255,255,0.03)] p-6 md:p-8">
    <h2 class="text-2xl md:text-3xl text-base-100 font-medium text-balance">Strategic Gut-Check</h2>
    <p class="mt-2 text-sm text-base-400">
      Don't let today's fires burn down tomorrow's goals.
    </p>

    <form id="compass-form" class="mt-6 space-y-4">
      <div>
        <label for="strategy" class="block text-sm font-medium text-base-100">Your North Star</label>
        <textarea
          id="strategy"
          rows="3"
          required
          placeholder="Transition from marketing to software engineering within 2 years"
          class="mt-2 w-full rounded-2xl border border-base-700 bg-base-900 px-4 py-3 text-sm text-base-100 placeholder:text-base-500 outline-none focus:border-primary"
        ></textarea>
        <p class="mt-2 text-xs text-base-500">Saved locally so you don't have to retype it.</p>
      </div>

      <div>
        <label for="action" class="block text-sm font-medium text-base-100">The Immediate Action</label>
        <textarea
          id="action"
          rows="3"
          required
          placeholder="Should I take on this high-paying freelance marketing gig this weekend?"
          class="mt-2 w-full rounded-2xl border border-base-700 bg-base-900 px-4 py-3 text-sm text-base-100 placeholder:text-base-500 outline-none focus:border-primary"
        ></textarea>
      </div>

      <button
        id="submit-btn"
        type="submit"
        class="px-6 font-medium h-10 text-sm bg-primary text-black rounded-full hover:opacity-90 duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Check Alignment
      </button>
    </form>

    <p id="error" class="mt-4 hidden text-sm text-red-400"></p>
    <div id="result" class="mt-5 hidden rounded-2xl border border-base-800 bg-base-900 p-5 text-sm text-base-100 flex gap-5 items-stretch"></div>
  </div>
</section>

<script>
  const isDebug = () => localStorage.getItem("debug") === "true";
  const log = (...args) => { if (isDebug()) console.log("[compass]", ...args); };

  const STORAGE_KEY = "north-star-strategy";

  const strategyEl = document.getElementById("strategy");
  const actionEl = document.getElementById("action");
  const formEl = document.getElementById("compass-form");
  const resultEl = document.getElementById("result");
  const errorEl = document.getElementById("error");
  const submitEl = document.getElementById("submit-btn");

  if (!strategyEl || !formEl || !actionEl || !resultEl || !errorEl || !submitEl) {
    console.warn("[compass] One or more required elements not found. Form will not work.", {
      strategyEl, formEl, actionEl, resultEl, errorEl, submitEl,
    });
  } else {
    function formatResult(text) {
      const fieldRegex = /\*\*([^*]+):\*\*\s*/g;
      const indices = [];
      let match;

      while ((match = fieldRegex.exec(text)) !== null) {
        indices.push({ label: match[1], start: match.index, contentStart: match.index + match[0].length });
      }

      if (indices.length === 0) {
        return `<div class="flex-1"><p class="text-base-300 leading-relaxed">${text}</p></div>`;
      }

      const fields = [];
      for (let i = 0; i < indices.length; i++) {
        const { label, contentStart } = indices[i];
        const end = i + 1 < indices.length ? indices[i + 1].start : text.length;
        fields.push({ label, value: text.slice(contentStart, end).trim() });
      }

      let gaugeHtml = "";
      const textFields = fields.filter(({ label, value }) => {
        if (!/score/i.test(label)) return true;
        const slashMatch = value.match(/(\d+)\s*\/\s*(\d+)/);
        const bareMatch = value.match(/^(\d+)/);
        if (!slashMatch && !bareMatch) return true;
        const score = parseInt(slashMatch ? slashMatch[1] : bareMatch[1], 10);
        const max = slashMatch ? parseInt(slashMatch[2], 10) : 10;
        const color = score <= 3 ? "#f87171" : score <= 6 ? "#fbbf24" : "#34d399";
        const segments = Array.from({ length: max }, (_, i) => {
          const segScore = i + 1; // bottom segment = 1, top = max
          const filled = segScore <= score;
          return `<div style="flex:1;border-radius:3px;background:${filled ? color : "#1e2535"}"></div>`;
        }).reverse().join("");
        gaugeHtml = `<div style="display:flex;flex-direction:column;align-items:center;gap:6px;width:48px;flex-shrink:0;align-self:stretch;padding-left:8px;border-left:1px solid #1e2535">
          <div style="flex:1;display:flex;flex-direction:column;gap:3px;width:100%">${segments}</div>
          <span style="font-size:9px;letter-spacing:0.06em;text-transform:uppercase;color:#94a3b8;text-align:center;line-height:1.3">Alignment<br>Score</span>
        </div>`;
        return false;
      });

      const fieldsHtml = textFields.map(({ label, value }) =>
        `<div>
          <p style="font-size:11px;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-primary);margin-bottom:4px">${label}</p>
          <p style="color:oklch(82.7% 0.008 262.74);line-height:1.6">${value}</p>
        </div>`
      ).join(`<div style="border-top:1px solid oklch(26.9% 0.012 267.01)"></div>`);

      return `<div style="flex:1;display:flex;flex-direction:column;gap:16px">${fieldsHtml}</div>${gaugeHtml}`;
    }

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      strategyEl.value = saved;
    }

    strategyEl.addEventListener("input", () => {
      localStorage.setItem(STORAGE_KEY, strategyEl.value);
    });

    formEl.addEventListener("submit", async (event) => {
      event.preventDefault();
      log("form submitted");
      resultEl.classList.add("hidden");
      errorEl.classList.add("hidden");
      submitEl.disabled = true;
      submitEl.textContent = "Evaluating...";

      try {
        log("fetching /api/evaluate", { strategy: strategyEl.value.slice(0, 40), action: actionEl.value.slice(0, 40) });
        const response = await fetch("/api/evaluate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            strategy: strategyEl.value,
            action: actionEl.value,
          }),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => null);
          log("response error", response.status, body);
          throw new Error(body?.error || `Request failed (${response.status})`);
        }

        const data = await response.json();
        log("response ok", { length: data.result?.length });
        resultEl.innerHTML = formatResult(data.result || "No response from model.");
        resultEl.classList.remove("hidden");
      } catch (error) {
        errorEl.textContent = error instanceof Error ? error.message : "Request failed.";
        errorEl.classList.remove("hidden");
      } finally {
        submitEl.disabled = false;
        submitEl.textContent = "Check Alignment";
      }
    });
  }
</script>

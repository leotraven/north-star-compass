---
// No server-side logic needed — page is fully client-rendered
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>North Star Compass</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        padding: 2rem 1rem;
      }

      .container {
        width: 100%;
        max-width: 640px;
      }

      header {
        text-align: center;
        margin-bottom: 2rem;
      }

      header h1 {
        font-size: 1.75rem;
        color: #f8fafc;
      }

      header p {
        color: #94a3b8;
        margin-top: 0.25rem;
        font-size: 0.95rem;
      }

      label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.375rem;
        font-size: 0.95rem;
      }

      textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        background: #1e293b;
        color: #e2e8f0;
        font-family: inherit;
        font-size: 0.95rem;
        resize: vertical;
      }

      textarea:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
      }

      .field {
        margin-bottom: 1.25rem;
      }

      .field .hint {
        color: #64748b;
        font-size: 0.8rem;
        margin-top: 0.25rem;
      }

      button {
        width: 100%;
        padding: 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        background: #6366f1;
        color: #fff;
        transition: background 0.15s;
      }

      button:hover:not(:disabled) {
        background: #4f46e5;
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      #result {
        margin-top: 1.5rem;
        padding: 1.25rem;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        white-space: pre-wrap;
        line-height: 1.6;
        display: none;
      }

      #error {
        margin-top: 1rem;
        color: #f87171;
        display: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <header>
        <h1>🧭 North Star Compass</h1>
        <p>Don't let today's fires burn down tomorrow's goals.</p>
      </header>

      <form id="compass-form">
        <div class="field">
          <label for="strategy">⭐ Your North Star</label>
          <textarea
            id="strategy"
            rows="3"
            placeholder="What is your long-term goal or core strategy?"
            required
          ></textarea>
          <p class="hint">Saved locally so you don't have to retype it.</p>
        </div>

        <div class="field">
          <label for="action">⚡ The Immediate Action</label>
          <textarea
            id="action"
            rows="3"
            placeholder="What decision or action are you considering right now?"
            required
          ></textarea>
        </div>

        <button type="submit" id="submit-btn">Check Alignment</button>
      </form>

      <div id="error"></div>
      <div id="result"></div>
    </div>

    <script>
      const STORAGE_KEY = "north-star-strategy";
      const strategyEl = document.getElementById("strategy") as HTMLTextAreaElement;
      const actionEl = document.getElementById("action") as HTMLTextAreaElement;
      const form = document.getElementById("compass-form") as HTMLFormElement;
      const resultEl = document.getElementById("result") as HTMLDivElement;
      const errorEl = document.getElementById("error") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      // Load saved strategy from localStorage
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) strategyEl.value = saved;

      // Persist strategy on change
      strategyEl.addEventListener("input", () => {
        localStorage.setItem(STORAGE_KEY, strategyEl.value);
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        resultEl.style.display = "none";
        errorEl.style.display = "none";
        submitBtn.disabled = true;
        submitBtn.textContent = "Evaluating…";

        try {
          const res = await fetch("/api/evaluate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              strategy: strategyEl.value,
              action: actionEl.value,
            }),
          });

          if (!res.ok) {
            const body = await res.json().catch(() => null);
            throw new Error(body?.error || `Request failed (${res.status})`);
          }

          const data = await res.json();
          resultEl.textContent = data.result;
          resultEl.style.display = "block";
        } catch (err: any) {
          errorEl.textContent = err.message;
          errorEl.style.display = "block";
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Check Alignment";
        }
      });
    </script>
  </body>
</html>

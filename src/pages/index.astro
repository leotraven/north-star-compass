---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- Sticky Header -->
  <header class="border-b border-border bg-card/80 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-primary/10 p-2 rounded-lg">
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-semibold tracking-tight">North Star Compass</h1>
          <p class="text-sm text-muted-foreground">Navigate Your Path to Success</p>
        </div>
      </div>
      <a href="/strategy" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border text-sm font-medium hover:bg-card transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
        </svg>
        View Strategy
      </a>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 py-8">
    <!-- Action Quick Check Section -->
    <section class="mb-10">
      <div class="relative overflow-hidden rounded-xl border border-border bg-card">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5 pointer-events-none"></div>
        <div class="relative p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <div class="bg-primary/10 p-2 rounded-lg">
                  <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                </div>
                <h2 class="text-xl font-semibold">Action Compatibility Check</h2>
              </div>
              <p class="text-muted-foreground max-w-2xl">
                Before making a decision, check if it aligns with your North Star goals and strategy.
                Get an instant compatibility score and AI-powered analysis.
              </p>
            </div>
            <a href="/check-action" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg text-sm font-medium shadow-lg hover:bg-primary/90 transition-colors whitespace-nowrap">
              Check Action
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Goals Section -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Your Goals</h2>
          <p class="text-muted-foreground mt-1">Track progress toward your North Star objectives</p>
        </div>
        <a href="/add-goal" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add Goal
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Goal: Financial -->
        <div class="rounded-xl border border-border bg-card p-5 hover:border-primary/50 transition-colors group">
          <div class="flex items-start justify-between mb-3">
            <span class="text-xs font-medium px-2 py-1 rounded bg-primary/10 text-primary">Financial</span>
            <div class="flex items-center gap-1 text-xs text-muted-foreground">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Dec 31, 2026
            </div>
          </div>
          <h3 class="font-semibold mb-4 group-hover:text-primary transition-colors">Increase Annual Revenue to $10M</h3>
          <div class="space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-muted-foreground">Progress</span>
              <span class="font-mono font-semibold text-primary">45%</span>
            </div>
            <div class="h-2 rounded-full bg-muted overflow-hidden">
              <div class="h-full bg-primary rounded-full" style="width: 45%"></div>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-border flex items-center gap-2 text-xs text-muted-foreground">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
            On track
          </div>
        </div>

        <!-- Goal: Growth -->
        <div class="rounded-xl border border-border bg-card p-5 hover:border-primary/50 transition-colors group">
          <div class="flex items-start justify-between mb-3">
            <span class="text-xs font-medium px-2 py-1 rounded bg-primary/10 text-primary">Growth</span>
            <div class="flex items-center gap-1 text-xs text-muted-foreground">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Sep 30, 2026
            </div>
          </div>
          <h3 class="font-semibold mb-4 group-hover:text-primary transition-colors">Launch Product in 3 New Markets</h3>
          <div class="space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-muted-foreground">Progress</span>
              <span class="font-mono font-semibold text-primary">60%</span>
            </div>
            <div class="h-2 rounded-full bg-muted overflow-hidden">
              <div class="h-full bg-primary rounded-full" style="width: 60%"></div>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-border flex items-center gap-2 text-xs text-muted-foreground">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
            On track
          </div>
        </div>

        <!-- Goal: Operations -->
        <div class="rounded-xl border border-border bg-card p-5 hover:border-primary/50 transition-colors group">
          <div class="flex items-start justify-between mb-3">
            <span class="text-xs font-medium px-2 py-1 rounded bg-primary/10 text-primary">Operations</span>
            <div class="flex items-center gap-1 text-xs text-muted-foreground">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Aug 15, 2026
            </div>
          </div>
          <h3 class="font-semibold mb-4 group-hover:text-primary transition-colors">Build Team of 50+ Employees</h3>
          <div class="space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-muted-foreground">Progress</span>
              <span class="font-mono font-semibold text-primary">30%</span>
            </div>
            <div class="h-2 rounded-full bg-muted overflow-hidden">
              <div class="h-full bg-primary rounded-full" style="width: 30%"></div>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-border flex items-center gap-2 text-xs text-muted-foreground">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
            On track
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

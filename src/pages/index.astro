---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/landing/Hero.astro";
import Compass from "../components/landing/Compass.astro";
---

<BaseLayout>
  <Hero />
  <Compass />

  <section class="max-w-6xl mx-auto px-6 py-12 border-t border-border">
    <h2 class="text-lg font-semibold mb-6">North Star Compass</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="rounded-xl border border-border bg-card p-6">
        <h3 class="font-semibold mb-2">Your Goals</h3>
        <p class="text-sm text-muted-foreground mb-4">Track and manage your personal goals.</p>
        <a href="/add-goal" class="text-sm text-primary hover:underline">Add a goal →</a>
      </div>
      <div class="rounded-xl border border-border bg-card p-6">
        <h3 class="font-semibold mb-2">Action Compatibility Check</h3>
        <p class="text-sm text-muted-foreground mb-4">Test whether an action aligns with your strategy.</p>
        <a href="/check-action" class="text-sm text-primary hover:underline">Check an action →</a>
      </div>
      <div class="rounded-xl border border-border bg-card p-6">
        <h3 class="font-semibold mb-2">Your Strategy</h3>
        <p class="text-sm text-muted-foreground mb-4">View your vision, values, and plan.</p>
        <a href="/strategy" class="text-sm text-primary hover:underline">View strategy →</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const coreValues = [
  "Integrity",
  "Growth",
  "Family",
  "Balance",
  "Courage",
  "Learning",
  "Freedom",
  "Creativity",
];

const visionDefault =
  "Healthy, fulfilled, and free - doing work that matters, surrounded by people I love, with time and energy to pursue what brings me alive.";
---

<BaseLayout>
  <header class="py-5 px-4 sm:px-8 border-b border-base-800">
    <div class="max-w-2xl mx-auto flex items-center gap-3">
      <a href="/" class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-base-800 text-base-400 hover:border-base-700 hover:text-base-100 transition-colors" aria-label="Back to dashboard">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
      </a>
      <div>
        <h1 class="text-base-100 font-medium">Your Strategy</h1>
        <p class="text-xs text-base-400">North Star alignment framework</p>
      </div>
    </div>
  </header>

  <main class="max-w-2xl mx-auto px-4 sm:px-8 py-8 space-y-4">
    <!-- Core Values -->
    <div class="rounded-2xl border border-base-800 bg-base-900 p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 class="text-base-100 font-medium">Core Values</h3>
        <div class="flex items-center gap-2">
          <button
            id="delete-core-values-btn"
            type="button"
            class="hidden p-2 rounded-full border border-base-800 text-base-500 hover:border-red-800 hover:text-red-400 transition-colors"
            aria-label="Delete all core values"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
          </button>
          <button
            id="edit-core-values-btn"
            type="button"
            class="hidden inline-flex items-center gap-2 px-4 h-9 rounded-full border border-base-700 text-base-300 text-sm font-medium hover:border-base-600 hover:text-base-100 duration-300"
          >
            Edit Core Values
          </button>
        </div>
      </div>

      <div id="core-values-empty-state" class="space-y-3">
        <p class="text-sm text-base-400">Start your strategy by choosing your core values.</p>
        <button
          id="choose-core-values-btn"
          type="button"
          class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300"
        >
          Choose Core Values
        </button>
      </div>

      <div id="core-value-options" class="hidden space-y-4 rounded-2xl border border-base-800 bg-base-925 p-4">
        <p class="text-sm text-base-400">Select up to 3 core values.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {coreValues.map((value) => (
            <label class="px-3 py-2 rounded-xl border border-base-800 hover:border-primary/50 cursor-pointer text-sm text-base-300">
              <input type="checkbox" class="mr-2 core-value-option" value={value} />
              <span>{value}</span>
            </label>
          ))}
        </div>
        <div class="flex items-center justify-between gap-3">
          <p id="core-values-limit-message" class="text-xs text-base-400">You can choose up to 3 values.</p>
          <button
            id="save-core-values-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300"
          >
            Save Core Values
          </button>
        </div>
      </div>

      <div id="selected-core-values" class="hidden mt-4">
        <div id="selected-core-values-grid" class="grid grid-cols-2 md:grid-cols-3 gap-3"></div>
      </div>
    </div>

    <!-- Mission and Strategic Pillars flow from your core values and vision -->

    <!-- Vision -->
    <div class="rounded-2xl border border-base-800 bg-base-900 p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 class="text-base-100 font-medium">Vision</h3>
        <div class="flex items-center gap-2">
          <button
            id="delete-vision-btn"
            type="button"
            class="hidden p-2 rounded-full border border-base-800 text-base-500 hover:border-red-800 hover:text-red-400 transition-colors"
            aria-label="Delete vision"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
          </button>
          <button
            id="edit-vision-btn"
            type="button"
            class="hidden inline-flex items-center gap-2 px-4 h-9 rounded-full border border-base-700 text-base-300 text-sm font-medium hover:border-base-600 hover:text-base-100 duration-300"
          >
            Edit Vision
          </button>
        </div>
      </div>

      <div id="vision-empty-state" class="space-y-3">
        <p class="text-sm text-base-400 italic">An inspiring picture of your ideal life 3-5 years from now.</p>
        <button
          id="choose-vision-btn"
          type="button"
          class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300"
        >
          Choose Vision
        </button>
      </div>

      <div id="vision-editor" class="hidden space-y-4 rounded-2xl border border-base-800 bg-base-925 p-4">
        <p class="text-sm text-base-400">Write or refine your long-term vision.</p>
        <textarea
          id="vision-input"
          rows="4"
          class="w-full rounded-2xl border border-base-700 bg-base-950 px-4 py-3 text-sm text-base-100 placeholder:text-base-500 outline-none focus:border-primary"
        >{visionDefault}</textarea>
        <div class="flex justify-end">
          <button
            id="save-vision-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300"
          >
            Save Vision
          </button>
        </div>
      </div>

      <div id="selected-vision" class="hidden mt-4 rounded-2xl bg-base-925 border border-base-800 p-4">
        <p id="selected-vision-text" class="text-sm text-base-300 leading-relaxed"></p>
      </div>
    </div>

    <!-- Goals -->
    <div class="rounded-2xl border border-base-800 bg-base-900 p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 class="text-base-100 font-medium">Goals</h3>
        <div class="flex items-center gap-2">
          <button
            id="delete-all-goals-btn"
            type="button"
            class="hidden p-2 rounded-full border border-base-800 text-base-500 hover:border-red-800 hover:text-red-400 transition-colors"
            aria-label="Delete all goals"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
          </button>
          <a href="/add-goal" class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add Goal
          </a>
        </div>
      </div>
      <div id="goals-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Goals rendered client-side from localStorage -->
      </div>
      <p id="goals-empty-state" class="hidden text-sm text-base-400">
        No goals yet. <a href="/add-goal" class="text-primary hover:underline">Add your first goal</a> to start tracking progress.
      </p>
    </div>

    <!-- Strategy Alignment CTA -->
    <div class="rounded-2xl border border-base-800 bg-base-900 p-6">
      <div class="mb-4">
        <h3 class="text-base-100 font-medium">Check Action Alignment</h3>
        <p class="mt-1 text-sm text-base-400">Describe an action or decision to evaluate whether it aligns with your strategy.</p>
      </div>
      <div class="space-y-4">
        <textarea
          id="strategy-action"
          rows="3"
          placeholder="e.g., Should I accept this new partnership opportunity that will require 3 months of engineering focus?"
          class="w-full rounded-2xl border border-base-700 bg-base-950 px-4 py-3 text-sm text-base-100 placeholder:text-base-500 outline-none focus:border-primary resize-none"
        ></textarea>
        <div class="flex items-center gap-3">
          <button
            id="strategy-analyze-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 h-10 bg-primary text-black rounded-full text-sm font-medium hover:opacity-90 duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Analyze Alignment
          </button>
          <div class="relative">
            <button
              id="analyze-info-btn"
              type="button"
              class="inline-flex items-center justify-center w-7 h-7 rounded-full border border-base-700 text-base-400 hover:border-base-500 hover:text-base-200 transition-colors text-xs font-medium"
              aria-label="Analysis quality info"
            >i</button>
            <div
              id="analyze-info-tooltip"
              class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 rounded-xl border border-base-700 bg-base-900 px-3 py-2 text-xs text-base-400 shadow-lg z-10"
              role="tooltip"
            >
              Analysis quality improves when core values, vision, and goals are all filled in.
              <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-base-700"></div>
            </div>
          </div>
        </div>
        <div id="strategy-loading" class="hidden text-sm text-base-400">Analyzing…</div>
        <p id="strategy-error" class="hidden text-sm text-red-400"></p>
        <div id="strategy-result" class="hidden space-y-3">
          <div id="result-core-values" class="rounded-2xl border border-base-800 bg-base-925 px-4 py-3 space-y-1"></div>
          <div id="result-vision" class="rounded-2xl border border-base-800 bg-base-925 px-4 py-3 space-y-1"></div>
          <div id="result-goals" class="space-y-2"></div>
          <div id="result-summary" class="rounded-2xl border border-primary/30 bg-base-925 px-4 py-3 space-y-1"></div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // @ts-nocheck
    const maxCoreValues = 3;
    const chooseBtn = document.getElementById("choose-core-values-btn");
    const editBtn = document.getElementById("edit-core-values-btn");
    const saveBtn = document.getElementById("save-core-values-btn");
    const emptyState = document.getElementById("core-values-empty-state");
    const optionsPanel = document.getElementById("core-value-options");
    const selectedSection = document.getElementById("selected-core-values");
    const selectedGrid = document.getElementById("selected-core-values-grid");
    const limitMessage = document.getElementById("core-values-limit-message");
    const checkboxes = Array.from(document.querySelectorAll(".core-value-option"));
    const chooseVisionBtn = document.getElementById("choose-vision-btn");
    const editVisionBtn = document.getElementById("edit-vision-btn");
    const saveVisionBtn = document.getElementById("save-vision-btn");
    const deleteVisionBtn = document.getElementById("delete-vision-btn");
    const deleteCoreValuesBtn = document.getElementById("delete-core-values-btn");
    const deleteAllGoalsBtn = document.getElementById("delete-all-goals-btn");
    const visionEmptyState = document.getElementById("vision-empty-state");
    const visionEditor = document.getElementById("vision-editor");
    const selectedVision = document.getElementById("selected-vision");
    const selectedVisionText = document.getElementById("selected-vision-text");
    const visionInput = document.getElementById("vision-input");

    const openOptions = () => {
      optionsPanel?.classList.remove("hidden");
      emptyState?.classList.add("hidden");
    };

    const renderSelectedValues = (values) => {
      if (!selectedGrid || !selectedSection) return;
      selectedGrid.innerHTML = "";

      values.forEach((value) => {
        const valueNode = document.createElement("div");
        valueNode.className = "px-4 py-3 rounded-2xl bg-base-800 border border-base-700 text-center";
        valueNode.innerHTML = `<span class=\"font-medium text-sm\">${value}</span>`;
        selectedGrid.appendChild(valueNode);
      });

      selectedSection.classList.toggle("hidden", values.length === 0);
      editBtn?.classList.toggle("hidden", values.length === 0);
      deleteCoreValuesBtn?.classList.toggle("hidden", values.length === 0);
    };

    const updateSelectionState = () => {
      const selectedCount = checkboxes.filter((option) => option.checked).length;
      const reachedLimit = selectedCount >= maxCoreValues;

      checkboxes.forEach((option) => {
        option.disabled = reachedLimit && !option.checked;
      });

      if (limitMessage) {
        limitMessage.textContent = reachedLimit
          ? "Maximum reached: you can only select 3 values."
          : "You can choose up to 3 values.";
      }
    };

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", updateSelectionState);
    });

    chooseBtn?.addEventListener("click", openOptions);
    editBtn?.addEventListener("click", openOptions);

    saveBtn?.addEventListener("click", () => {
      const selectedValues = checkboxes
        .filter((option) => option.checked)
        .slice(0, maxCoreValues)
        .map((option) => option.value);

      renderSelectedValues(selectedValues);
      optionsPanel?.classList.add("hidden");
      emptyState?.classList.add("hidden");
      persistStrategy();
    });

    const openVisionEditor = () => {
      visionEditor?.classList.remove("hidden");
      visionEmptyState?.classList.add("hidden");
    };

    const renderVision = (vision) => {
      if (!selectedVision || !selectedVisionText) return;
      selectedVisionText.textContent = vision;
      selectedVision.classList.toggle("hidden", !vision);
      editVisionBtn?.classList.toggle("hidden", !vision);
      deleteVisionBtn?.classList.toggle("hidden", !vision);
    };

    chooseVisionBtn?.addEventListener("click", openVisionEditor);
    editVisionBtn?.addEventListener("click", openVisionEditor);

    saveVisionBtn?.addEventListener("click", () => {
      const vision = visionInput?.value.trim() || visionInput?.defaultValue || "";
      renderVision(vision);
      visionEditor?.classList.add("hidden");
      visionEmptyState?.classList.add("hidden");
      persistStrategy();
    });

    updateSelectionState();

    const STRATEGY_KEY = "north-star-strategy";
    const GOALS_KEY = "north-star-goals";

    const loadStoredStrategy = () => {
      try { return JSON.parse(localStorage.getItem(STRATEGY_KEY) ?? "null"); } catch { return null; }
    };

    // ── Render goals from localStorage ───────────────────────────────────────
    const goalsGrid = document.getElementById("goals-grid");
    const goalsEmptyState = document.getElementById("goals-empty-state");

    const renderGoals = () => {
      const goals = JSON.parse(localStorage.getItem(GOALS_KEY) ?? "[]");
      if (!goalsGrid) return;
      goalsGrid.innerHTML = "";
      if (goals.length === 0) {
        goalsEmptyState?.classList.remove("hidden");
        deleteAllGoalsBtn?.classList.add("hidden");
      } else {
        goalsEmptyState?.classList.add("hidden");
        deleteAllGoalsBtn?.classList.remove("hidden");
        goals.forEach((goal) => {
          const card = document.createElement("div");
          card.className = "rounded-2xl border border-base-800 bg-base-900 p-5 hover:border-primary/50 transition-colors group relative";
          card.innerHTML = `
            <button
              class="delete-goal-btn absolute top-3 right-3 p-1.5 rounded-lg text-base-600 hover:text-red-400 hover:bg-base-800 transition-colors"
              aria-label="Remove goal"
              data-id="${goal.id}"
            >
              <svg class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
              </svg>
            </button>
            <div class="flex items-center gap-1 text-xs text-base-400 mb-3">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              ${goal.deadline}
            </div>
            <h3 class="font-semibold group-hover:text-primary transition-colors pr-6">${goal.title}</h3>
          `;
          goalsGrid.appendChild(card);
        });
      }
    };

    deleteCoreValuesBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => { cb.checked = false; });
      updateSelectionState();
      renderSelectedValues([]);
      optionsPanel?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      persistStrategy();
    });

    deleteVisionBtn?.addEventListener("click", () => {
      if (visionInput) visionInput.value = "";
      renderVision("");
      visionEditor?.classList.add("hidden");
      visionEmptyState?.classList.remove("hidden");
      persistStrategy();
    });

    deleteAllGoalsBtn?.addEventListener("click", () => {
      localStorage.setItem(GOALS_KEY, JSON.stringify([]));
      renderGoals();
    });

    goalsGrid?.addEventListener("click", (e) => {
      const btn = e.target.closest(".delete-goal-btn");
      if (!btn) return;
      const id = btn.dataset.id;
      const goals = JSON.parse(localStorage.getItem(GOALS_KEY) ?? "[]").filter((g) => g.id !== id);
      localStorage.setItem(GOALS_KEY, JSON.stringify(goals));
      renderGoals();
    });

    renderGoals();

    // ── Restore persisted vision and core values ──────────────────────────────
    const storedStrategy = loadStoredStrategy();
    if (storedStrategy) {
      if (Array.isArray(storedStrategy.coreValues) && storedStrategy.coreValues.length > 0) {
        storedStrategy.coreValues.forEach((v) => {
          const cb = checkboxes.find((c) => c.value === v);
          if (cb) cb.checked = true;
        });
        updateSelectionState();
        const selectedValues = storedStrategy.coreValues;
        renderSelectedValues(selectedValues);
        optionsPanel?.classList.add("hidden");
        emptyState?.classList.add("hidden");
      }
      if (storedStrategy.vision) {
        if (visionInput) visionInput.value = storedStrategy.vision;
        renderVision(storedStrategy.vision);
        visionEditor?.classList.add("hidden");
        visionEmptyState?.classList.add("hidden");
      }
    }

    const strategyActionEl = document.getElementById("strategy-action");
    const strategyAnalyzeBtn = document.getElementById("strategy-analyze-btn");
    const strategyLoading = document.getElementById("strategy-loading");
    const strategyError = document.getElementById("strategy-error");
    const strategyResult = document.getElementById("strategy-result");
    const resultVisionEl = document.getElementById("result-vision");
    const resultCoreValuesEl = document.getElementById("result-core-values");
    const resultGoalsEl = document.getElementById("result-goals");
    const resultSummaryEl = document.getElementById("result-summary");

    const analyzeInfoBtn = document.getElementById("analyze-info-btn");
    const analyzeInfoTooltip = document.getElementById("analyze-info-tooltip");

    analyzeInfoBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      analyzeInfoTooltip?.classList.toggle("hidden");
    });

    document.addEventListener("click", () => {
      analyzeInfoTooltip?.classList.add("hidden");
    });

    const persistStrategy = () => {
      const vision = selectedVisionText?.textContent?.trim() ||
        visionInput?.value?.trim() || visionInput?.defaultValue || "";
      const coreValues = checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);
      localStorage.setItem(STRATEGY_KEY, JSON.stringify({ vision, coreValues }));
    };

    const getPageVision = () => {
      const saved = document.getElementById("selected-vision-text");
      if (saved && !selectedVision?.classList.contains("hidden")) {
        return saved.textContent?.trim() || "";
      }
      return visionInput?.value?.trim() || visionInput?.defaultValue || "";
    };

    const getPageCoreValues = () =>
      checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);

    const renderScoreCard = (container, title, score, explanation) => {
      container.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-100">${title}</span>
          <span class="text-sm font-semibold text-primary">${score}/10</span>
        </div>
        <p class="text-xs text-base-400">${explanation}</p>
      `;
    };

    const renderNoInfoCard = (container, title) => {
      container.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-100">${title}</span>
        </div>
        <p class="text-xs text-base-400 italic">No information provided — assessment cannot be given.</p>
      `;
    };

    strategyAnalyzeBtn?.addEventListener("click", async () => {
      const action = strategyActionEl?.value?.trim();
      if (!action) {
        strategyActionEl?.focus();
        return;
      }

      const vision = getPageVision();
      const coreValues = getPageCoreValues();
      const goalsData = JSON.parse(localStorage.getItem(GOALS_KEY) ?? "[]");
      const goals = goalsData.map((g) => ({ title: g.title }));

      const hasCoreValues = coreValues.length > 0;
      const hasVision = !!vision;
      const hasGoals = goals.length > 0;

      strategyAnalyzeBtn.disabled = true;
      strategyResult?.classList.add("hidden");
      strategyError?.classList.add("hidden");
      strategyLoading?.classList.remove("hidden");

      try {
        const res = await fetch("/api/evaluate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ vision, coreValues, goals, action }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error ?? `HTTP ${res.status}`);
        }

        const data = await res.json();

        if (resultCoreValuesEl) {
          if (hasCoreValues && data.coreValues) {
            renderScoreCard(resultCoreValuesEl, "Core Values", data.coreValues.score, data.coreValues.explanation);
          } else {
            renderNoInfoCard(resultCoreValuesEl, "Core Values");
          }
        }

        if (resultVisionEl) {
          if (hasVision && data.vision) {
            renderScoreCard(resultVisionEl, "Vision", data.vision.score, data.vision.explanation);
          } else {
            renderNoInfoCard(resultVisionEl, "Vision");
          }
        }

        if (resultGoalsEl) {
          resultGoalsEl.innerHTML = "";
          if (hasGoals && Array.isArray(data.goals) && data.goals.length > 0) {
            data.goals.forEach((goal) => {
              const card = document.createElement("div");
              card.className = "rounded-2xl border border-base-800 bg-base-925 px-4 py-3 space-y-1";
              card.innerHTML = `
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-base-100">${goal.title}</span>
                  <span class="text-sm font-semibold text-primary">${goal.score}/10</span>
                </div>
                <p class="text-xs text-base-400">${goal.explanation}</p>
              `;
              resultGoalsEl.appendChild(card);
            });
          } else {
            const card = document.createElement("div");
            card.className = "rounded-2xl border border-base-800 bg-base-925 px-4 py-3 space-y-1";
            card.innerHTML = `
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-base-100">Goals</span>
              </div>
              <p class="text-xs text-base-400 italic">No information provided — assessment cannot be given.</p>
            `;
            resultGoalsEl.appendChild(card);
          }
        }

        if (resultSummaryEl && data.summary) {
          renderScoreCard(resultSummaryEl, "Overall Summary", data.summary.score, data.summary.explanation);
        }

        strategyResult?.classList.remove("hidden");
      } catch (err) {
        if (strategyError) {
          strategyError.textContent = `Error: ${err.message}`;
          strategyError.classList.remove("hidden");
        }
      } finally {
        strategyLoading?.classList.add("hidden");
        strategyAnalyzeBtn.disabled = false;
      }
    });
  </script>
</BaseLayout>

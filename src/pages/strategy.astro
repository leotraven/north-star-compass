---
import BaseLayout from "../layouts/BaseLayout.astro";

const coreValues = [
  "Integrity",
  "Growth",
  "Family",
  "Balance",
];

const pillars = [
  {
    title: "Health",
    description: "Maintain physical and mental wellbeing as the foundation for everything else",
    initiatives: [
      "Build a consistent workout routine",
      "Improve sleep quality to 7–8 hours",
      "Practice mindfulness daily",
    ],
    icon: "heart",
  },
  {
    title: "Career",
    description: "Grow professionally and create meaningful work aligned with what matters most",
    initiatives: [
      "Launch personal project by August 2026",
      "Deepen skills in areas that excite you",
      "Build meaningful professional connections",
    ],
    icon: "briefcase",
  },
  {
    title: "Relationships",
    description: "Nurture deep connections with family and friends that bring joy and support",
    initiatives: [
      "Weekly quality time with loved ones",
      "Be fully present in every interaction",
      "Strengthen friendships through regular check-ins",
    ],
    icon: "users",
  },
];

const goals = [
  { title: "Run my first marathon", deadline: "Dec 31, 2026" },
  { title: "Read 24 books this year", deadline: "Dec 31, 2026" },
  { title: "Launch my personal project", deadline: "Aug 15, 2026" },
];
---

<BaseLayout>
  <header class="border-b border-border bg-card/80 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/" class="inline-flex items-center justify-center w-9 h-9 rounded-lg hover:bg-card transition-colors" aria-label="Back to dashboard">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
        </a>
        <div class="flex items-center gap-3">
          <div class="bg-primary/10 p-2 rounded-lg">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-semibold">Your Strategy</h1>
            <p class="text-sm text-muted-foreground">North Star alignment framework</p>
          </div>
        </div>
      </div>
      <a href="/create-strategy" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border text-sm font-medium hover:bg-card transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Edit Strategy
      </a>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-8 space-y-8">
    <!-- Core Values -->
    <div class="rounded-xl border border-border bg-card p-6">
      <h3 class="font-semibold mb-4">Core Values</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {coreValues.map((value) => (
          <div class="px-4 py-3 rounded-lg bg-primary/5 border border-primary/20 text-center">
            <span class="font-medium text-sm">{value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Vision -->
    <div class="rounded-xl border border-primary/20 bg-card p-6">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-2 h-2 rounded-full bg-primary"></div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-primary">Vision</h3>
      </div>
      <p class="leading-relaxed text-muted-foreground text-sm mb-2 italic">An inspiring picture of your ideal life 3–5 years from now</p>
      <p class="leading-relaxed" id="vision-text">
        Healthy, fulfilled, and free — doing work that matters, surrounded by people I love, with time and energy to pursue what brings me alive.
      </p>
    </div>

    <!-- Life Pillars -->
    <div>
      <h2 class="text-2xl font-semibold mb-6">Life Pillars</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {pillars.map((pillar) => (
          <div class="rounded-xl border border-border bg-card p-6 hover:border-primary/50 transition-colors">
            <div class="bg-primary/10 w-12 h-12 rounded-lg flex items-center justify-center mb-4">
              {pillar.icon === "heart" && (
                <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              )}
              {pillar.icon === "briefcase" && (
                <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {pillar.icon === "users" && (
                <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              )}
            </div>
            <h3 class="font-semibold mb-2">{pillar.title}</h3>
            <p class="text-sm text-muted-foreground mb-4 leading-relaxed">{pillar.description}</p>
            <div class="space-y-2">
              <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Key Areas</p>
              <ul class="space-y-2">
                {pillar.initiatives.map((item) => (
                  <li class="flex gap-2 text-sm">
                    <div class="w-1 h-1 rounded-full bg-primary mt-2 flex-shrink-0"></div>
                    <span class="text-muted-foreground">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Goals -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Goals</h2>
        <a href="/add-goal" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add Goal
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {goals.map((goal) => (
          <div class="rounded-xl border border-border bg-card p-5 hover:border-primary/50 transition-colors group">
            <div class="flex items-center gap-1 text-xs text-muted-foreground mb-3">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              {goal.deadline}
            </div>
            <h3 class="font-semibold group-hover:text-primary transition-colors">{goal.title}</h3>
          </div>
        ))}
      </div>
    </div>

    <!-- Strategy Alignment CTA -->
    <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
      <div class="flex items-start gap-4">
        <div class="bg-primary/20 p-3 rounded-lg flex-shrink-0">
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold mb-1">Check Action Alignment</h3>
          <p class="text-sm text-muted-foreground mb-4">
            Use the Action Compatibility Check to evaluate whether your daily decisions align with this strategy.
          </p>
          <a href="/check-action" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors">
            Check an Action
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
